{
  "manifest_version": 3,
  "name": "Chuspa",
  "version": "0.7.5",
  "description": "Llaves de acceso (passkeys) de Chuspa. La bóveda vive en la aplicación, no en el navegador.",
  "author": "Juan Carlos Isaza",
  "homepage_url": "https://github.com/isazajuancarlos/chuspa",
  "key": "",
  "minimum_chrome_version": "111",
  "permissions": [
    "nativeMessaging"
  ],
  "action": {
    "default_title": "Chuspa",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "background": {
    "service_worker": "fondo.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://localhost/*"
      ],
      "js": [
        "puente-passkeys.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://*/*",
        "http://localhost/*"
      ],
      "js": [
        "passkeys.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*"
  ]
}
